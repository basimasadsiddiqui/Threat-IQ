# ============================================================================
# ThreatIQ configuration
#
# Everything here is OPTIONAL. With an empty .env the whole pipeline still
# runs: tools without keys report `skipped`, the deterministic risk engine and
# framework mapper work unchanged, and only the narrative prose is reduced.
# ============================================================================

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret between the UI and the API. LEAVE EMPTY ONLY FOR LOCAL DEV -
# an empty value disables authentication entirely.
API_KEY=
CORS_ORIGINS=http://localhost:8501

# --- LLM (pick one provider) ----------------------------------------------
LLM_PROVIDER=groq           # groq | gemini | none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1

# --- Database --------------------------------------------------------------
# Empty -> in-memory repository (data lost on restart).
DATABASE_URL=postgresql+psycopg://threatiq:threatiq@postgres:5432/threatiq

# --- External security APIs (all free tiers) -------------------------------
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# https://urlscan.io/user/profile/  (search works unauthenticated too)
URLSCAN_API_KEY=
# https://nvd.nist.gov/developers/request-an-api-key  (raises the rate limit)
NVD_API_KEY=

# --- Active scanning -------------------------------------------------------
# ZAP is only used for hosts listed below. An empty list refuses every scan.
ZAP_BASE_URL=
ZAP_API_KEY=
# Comma-separated hosts YOU OWN or are contractually authorised to test.
# Subdomains of a listed apex are included; substring matches are not.
AUTHORIZED_SCAN_TARGETS=

# --- Budgets ---------------------------------------------------------------
TOOL_TIMEOUT_S=20
MAX_INVESTIGATION_SECONDS=180

# --- Rate limiting ---------------------------------------------------------
# Outbound calls are paced per source against the published free-tier quotas.
# The threat-intel agent fans out concurrently while VirusTotal's free API
# allows 4 requests a minute, so without pacing most of those calls come back
# 429 and the investigation quietly loses its reputation coverage.
#
# A call that cannot get quota inside this budget is reported as rate-limited
# rather than queued, so one throttled source cannot eat the whole
# investigation deadline. Rate-limited is treated as missing coverage by the
# risk engine, never as a clean result.
RATE_LIMIT_MAX_WAIT_S=25
# Raise the ceilings if you hold a paid tier, as "source=requests/seconds":
#   RATE_LIMIT_OVERRIDES=virustotal=1000/60,abuseipdb=50000/86400
RATE_LIMIT_OVERRIDES=

# --- Guardrails ------------------------------------------------------------
# Hard ceiling on any single upstream response body. http_probe fetches URLs
# chosen by an attacker, so without a cap a hostile host can answer with a
# multi-gigabyte body and exhaust the container. The CISA KEV catalogue is a
# single large document and has its own higher ceiling.
MAX_RESPONSE_BYTES=2000000
KEV_MAX_RESPONSE_BYTES=30000000

# Inbound abuse controls. One POST /investigate carrying a long list of URLs
# makes ThreatIQ fetch every one, so an unlimited endpoint is a scanning proxy:
# the victim's logs would show this host as the scanner. Set the rate to 0 to
# disable, for example when a gateway in front already limits.
INBOUND_RATE_PER_MINUTE=20
INBOUND_BURST=10
MAX_CONCURRENT_INVESTIGATIONS=4

# --- Observability ---------------------------------------------------------
# LangSmith traces the agent graph and any LLM calls that go through
# LangChain. Set both of the first two and restart the API; traces appear under
# the project name below at smith.langchain.com. Get a key from that site.
#
# Caveat worth knowing: the LLM layer falls back to raw httpx when a LangChain
# provider package is missing, and LangSmith cannot see those calls. Run
# `make verify` to check which path your LLM calls are actually taking.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=threatiq
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
